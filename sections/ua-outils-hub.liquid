<style>
#ua-outils-hub-art .ua-art-card{background:var(--aqua-white,#fff);height:100%}
#ua-outils-hub-art .ua-art-media{aspect-ratio:4/3;overflow:hidden;background:var(--aqua-cream,#DEF1F0)}
#ua-outils-hub-art .ua-art-img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transform:scale(1);transition:transform 1.2s var(--ua-ease-out,ease)}
#ua-outils-hub-art .ua-art-card:hover .ua-art-img{transform:scale(1.05)}
#ua-outils-hub-art .ua-art-title{display:-webkit-box!important;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:break-word}
#ua-outils-hub-art .ua-art-exc{color:var(--aqua-text-soft,#4A5464);font-size:.875rem;line-height:1.5}
#ua-outils-hub-art .ua-art-exc p{display:-webkit-box!important;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;margin:0}
#ua-outils-hub-art .ua-art-rule{position:absolute;bottom:0;left:0;width:100%;height:1px;background:currentColor;transform-origin:right;transition:transform .3s var(--ua-ease-out,ease)}
#ua-outils-hub-art .ua-art-card:hover .ua-art-rule{transform:scaleX(0);transform-origin:left}
</style>
