    <div class="relative ua-art-media">{%- if ua_a.image -%}<img src="{{ ua_a.image | image_url: width: 600 }}" alt="{{ ua_a.title | escape }}" loading="lazy" width="440" height="330" class="ua-art-img">{%- else -%}<div class="absolute inset-0 bg-sea-25"></div>{%- endif -%}</div>
    <div class="flex flex-col flex-1 p-4 s:p-6">
      <h3 class="type-h6 mb-2"><a href="{{ ua_a.url }}" class="before:absolute before:inset-0 before:block"><span class="ua-art-title">{{ ua_a.title | escape }}</span></a></h3>
      {%- if ua_a.excerpt != blank -%}<div class="ua-art-exc"><p>{{ ua_a.excerpt | strip_html | truncatewords: 40, '' }}</p></div>{%- endif -%}
      <div class="pt-4" style="margin-top:auto"><span class="relative inline-block font-bold text-sm">{{ 'ua.articles.read_more' | t }}<span class="ua-art-rule"></span></span></div>
    </div>
  </article>
</div>{%- endif -%}{%- endcapture -%}
      {% render 'slider', content: ua_arts %}
    </div>
  </div>
</section>
<style>
#ua-outil-art-quel-poisson .ua-art-card{background:var(--aqua-white,#fff);height:100%}
#ua-outil-art-quel-poisson .ua-art-media{aspect-ratio:4/3;overflow:hidden;background:var(--aqua-cream,#DEF1F0)}
#ua-outil-art-quel-poisson .ua-art-img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transform:scale(1);transition:transform 1.2s var(--ua-ease-out,ease)}
#ua-outil-art-quel-poisson .ua-art-card:hover .ua-art-img{transform:scale(1.05)}
#ua-outil-art-quel-poisson .ua-art-title{display:-webkit-box!important;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:break-word}
#ua-outil-art-quel-poisson .ua-art-exc{color:var(--aqua-text-soft,#4A5464);font-size:.875rem;line-height:1.5}
#ua-outil-art-quel-poisson .ua-art-exc p{display:-webkit-box!important;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;margin:0}
#ua-outil-art-quel-poisson .ua-art-rule{position:absolute;bottom:0;left:0;width:100%;height:1px;background:currentColor;transform-origin:right;transition:transform .3s var(--ua-ease-out,ease)}
#ua-outil-art-quel-poisson .ua-art-card:hover .ua-art-rule{transform:scaleX(0);transform-origin:left}
</style>
