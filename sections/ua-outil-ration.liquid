<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebApplication","name":"Ration selon la température","alternateName":"Nourrir selon la température","description":"À quelle température arrêter de nourrir les poissons du bassin ? Ration du jour en grammes, nombre de repas et aliment adapté, de 5 à 30 °C, pour koïs et poissons rouges.","url":"https://www.univers-aquaponie.com/pages/nourrir-poissons-bassin","applicationCategory":"Calculateur de ration","operatingSystem":"Tous","isAccessibleForFree":true,"offers":{"@type":"Offer","price":"0","priceCurrency":"EUR"},"inLanguage":"fr","featureList":["Ration du jour en grammes","Nombre de repas","Aliment adapté à la température","Oxygène à saturation"],"dateModified":"2026-11-09","publisher":{"@type":"Organization","name":"Univers Aquaponie","url":"https://www.univers-aquaponie.com"},"citation":[{"@type":"CreativeWork","name":"Aliment Wheat Germ Floating","author":"Fiche Univers Aquaponie, relevée le 09/11/2026","url":"https://www.univers-aquaponie.com/products/aliment-wheat-germ-floating"},{"@type":"CreativeWork","name":"Aliment All Seasons","author":"Fiche Univers Aquaponie, relevée le 09/11/2026","url":"https://www.univers-aquaponie.com/products/aliment-all-seasons"},{"@type":"CreativeWork","name":"Aliment Excellent Color","author":"Fiche Univers Aquaponie, relevée le 09/11/2026","url":"https://www.univers-aquaponie.com/products/aliment-excellent-color"},{"@type":"CreativeWork","name":"Small-scale aquaponic food production, chapitre 8","author":"Somerville et al., FAO, 2014","url":"https://www.fao.org/3/i4021e/i4021e.pdf"},{"@type":"CreativeWork","name":"Technical Memorandum 2011.03, oxygène dissous","author":"USGS, d'après Benson et Krause, 1980 et 1984","url":"https://water.usgs.gov/water-resources/memos/documents/WQ.2011.03.pdf"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.univers-aquaponie.com/"},{"@type":"ListItem","position":2,"name":"Outils","item":"https://www.univers-aquaponie.com/pages/outils"},{"@type":"ListItem","position":3,"name":"Nourrir selon la température","item":"https://www.univers-aquaponie.com/pages/nourrir-poissons-bassin"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"À quelle température arrêter de nourrir les poissons du bassin ?","acceptedAnswer":{"@type":"Answer","text":"Sous 5 °C, on ne nourrit plus. Entre 5 et 10 °C, deux à trois petites distributions par semaine d'un aliment au germe de blé suffisent."}},{"@type":"Question","name":"Quand reprendre le nourrissage au printemps ?","acceptedAnswer":{"@type":"Answer","text":"Quand l'eau tient plusieurs jours au-dessus de 10 °C, mesurée le matin. Reprenez avec un aliment au germe de blé, un repas par jour, puis passez à un aliment complet vers 15 °C."}},{"@type":"Question","name":"Combien de nourriture donner à des koïs ?","acceptedAnswer":{"@type":"Answer","text":"Entre 0,5 et 2 % de leur poids par jour selon la température. Pour 10 kg de koïs dans une eau à 22 °C, comptez 200 g par jour en plusieurs petits repas."}},{"@type":"Question","name":"Pourquoi du germe de blé en automne ?","acceptedAnswer":{"@type":"Answer","text":"Il est moins riche en protéines et se digère plus vite à basse température. Les fiches des aliments au germe de blé annoncent un emploi de 5 à 15 °C."}},{"@type":"Question","name":"Faut-il nourrir pendant une canicule ?","acceptedAnswer":{"@type":"Answer","text":"Moins. Une eau à 30 °C ne retient que 7,6 mg d'oxygène par litre à saturation, contre 9,1 à 20 °C. Réduisez la ration, nourrissez le matin et aérez."}},{"@type":"Question","name":"Comment connaître le poids de mes poissons ?","acceptedAnswer":{"@type":"Answer","text":"Pesez un poisson représentatif dans un seau d'eau posé sur une balance, en soustrayant le seau, puis multipliez par le nombre. L'outil travaille sur ce poids total."}},{"@type":"Question","name":"Un distributeur automatique, c'est utile ?","acceptedAnswer":{"@type":"Answer","text":"Pour partir quelques jours en saison chaude, oui. Réglez-le sur la ration du jour de l'outil, en plusieurs petites distributions."}}]}]}</script>
